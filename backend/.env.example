# ===================================================
# BUSINESS MANAGER - BACKEND ENVIRONMENT VARIABLES
# ===================================================

# Django Security
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Optional - defaults to local SQLite if unset)
# DATABASE_URL=postgres://user:password@localhost:5432/business_manager

# URLs Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===================================================
# MERCADO PAGO INTEGRATION (Checkout Pro & Webhooks)
# ===================================================
# Obtain free from: https://www.mercadopago.com.ar/developers
# Leave blank to use local simulation/mock mode.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
MERCADOPAGO_WEBHOOK_SECRET=

# Pricing Overrides (Optional - defaults to $10.000 / $100.000 ARS)
# SUBSCRIPTION_PRICE_MONTHLY=10000.00
# SUBSCRIPTION_PRICE_YEARLY=100000.00
